# ==============================================================================
# МОТО-АЛЬЯНС КУБАНЬ // ОБРАЗЕЦ КОНФИГУРАЦИИ .ENV
# ==============================================================================

# Вставьте ваш API-ключ от DeepInfra:
DEEPINFRA_API_KEY=your_deepinfra_api_key_here

# Модель ИИ (DeepSeek v4.1 / V3 / R1):
DEEPINFRA_MODEL=deepseek-ai/DeepSeek-V3

# Кэширование (экономия токенов и мгновенные ответы):
CACHE_ENABLED=true
CACHE_TTL_HOURS=72

# Порт:
PORT=8000
